{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MOCKA_LIVING_CONTEXT_SNAPSHOT_v1.schema.json",
  "title": "MOCKA_LIVING_CONTEXT_SNAPSHOT_v1",
  "type": "object",
  "required": [
    "schema_version", "generated_at", "project", "current_state", "completed",
    "active", "blocked", "decisions", "unknowns", "next_boundary",
    "human_gate_required", "source_lineage"
  ],
  "properties": {
    "schema_version": {"const": "MOCKA_LIVING_CONTEXT_SNAPSHOT_v1"},
    "generated_at": {"type": "string"},
    "project": {"type": "object", "required": ["name", "phase", "branch"]},
    "current_state": {"type": "object", "required": ["summary"]},
    "completed": {"type": "object", "required": ["items"]},
    "active": {"type": "object", "required": ["items"]},
    "blocked": {"type": "object", "required": ["items"]},
    "decisions": {"type": "array", "items": {"type": "object", "required": ["id", "status", "summary"]}},
    "unknowns": {"type": "object", "required": ["items"]},
    "next_boundary": {"type": "object", "required": ["description"]},
    "human_gate_required": {"type": "boolean"},
    "source_lineage": {"type": "array", "minItems": 1}
  }
}
