# MoCKA 環境変数設定例
# このファイルを .env にコピーして実際の値を設定してください。
# cp .env.example .env

# ngrok または外部公開エンドポイントのベースURL（末尾スラッシュなし）
# 例: https://xxxx-xxxx-xxxx.ngrok-free.app
# 未設定時は各スクリプトが起動時エラーを出力し、localhost にフォールバックします。
MOCKA_ENDPOINT=https://your-ngrok-url.ngrok-free.app

# MoCKA API認証キー（カンマ区切り複数指定可）
# 例: key1,key2,key3
# このキーはHTTPリクエストのX-MoCKA-Keyヘッダで検証されます
MOCKA_API_KEYS=your-api-key-1,your-api-key-2

# MoCKA HMAC署名シークレット
# リクエストの署名検証に使用されます（POST /api/v1/event等）
# 例: my-secret-key-for-hmac-verification
MOCKA_HMAC_SECRET=your-hmac-secret-key
